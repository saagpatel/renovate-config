{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "Shared Renovate config for saagpatel portfolio",
	"platform": "github",
	"repositories": [
		"saagpatel/Premise",
		"saagpatel/sovereign",
		"saagpatel/signal-noise",
		"saagpatel/NeuralNetwork",
		"saagpatel/OrbitMechanics",
		"saagpatel/HowMoneyMoves"
	],
	"extends": [
		"config:recommended",
		"group:allNonMajor",
		":separateMajorReleases",
		":automergeMinor",
		":automergePatch",
		"schedule:weekly"
	],
	"labels": ["dependencies"],
	"automerge": true,
	"automergeType": "pr",
	"platformAutomerge": true,
	"packageRules": [
		{
			"description": "Auto-merge patch and minor updates",
			"matchUpdateTypes": ["patch", "minor"],
			"automerge": true
		},
		{
			"description": "Group all non-major updates into one PR per repo",
			"matchUpdateTypes": ["patch", "minor", "pin", "digest"],
			"groupName": "all non-major dependencies",
			"groupSlug": "all-minor-patch"
		},
		{
			"description": "Do NOT auto-merge major updates — require review",
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"labels": ["dependencies", "major"]
		},
		{
			"description": "Auto-merge Rust crate patches",
			"matchManagers": ["cargo"],
			"matchUpdateTypes": ["patch", "minor"],
			"automerge": true,
			"groupName": "rust dependencies"
		},
		{
			"description": "Auto-merge dev dependencies always",
			"matchDepTypes": ["devDependencies"],
			"automerge": true,
			"groupName": "dev dependencies"
		}
	],
	"vulnerabilityAlerts": {
		"enabled": true,
		"labels": ["security"]
	},
	"prConcurrentLimit": 3,
	"prHourlyLimit": 2,
	"timezone": "America/New_York",
	"schedule": ["before 8am on monday"]
}
